name: "家庭分流与DNS 2026-10-21"
desc: "导入后先选择可用节点；需要 Stash iOS 3.6+，并下载首次使用的规则数据。"
ipv6: false
dns: #!replace
  {"follow-rule":true,"skip-cert-verify":false,"ipv6":false,"default-nameserver":["https://223.5.5.5/dns-query"],"proxy-server-nameserver":["https://223.5.5.5/dns-query","https://doh.pub/dns-query"],"nameserver":["https://1.1.1.1/dns-query","https://8.8.8.8/dns-query"],"nameserver-policy":{"geosite:cn":["https://223.5.5.5/dns-query"],"rule-set:family-apple-cn":["https://223.5.5.5/dns-query"],"geosite:apple@cn":["https://223.5.5.5/dns-query"],"geosite:microsoft@cn":["https://223.5.5.5/dns-query"],"geosite:onedrive":["https://223.5.5.5/dns-query"]},"fallback":[],"fake-ip-filter":["*.lan","*.local","localhost","localhost.ptlogin2.qq.com","*.qq.com","*.weixin.qq.com","*.weixin.com","*.wechat.com","*.gtimg.com","*.qpic.cn","*.qlogo.cn","*.servicewechat.com","+.stun.*.*","+.stun.*.*.*","+.stun.*.*.*.*","*.n.n.srv.nintendo.net","+.stun.playstation.net","*.msftncsi.com","*.msftconnecttest.com","*.mcdn.bilivideo.cn"]}
proxy-groups:
  [{"name":"家庭代理","type":"select","include-all":true,"interval":600,"lazy":true},{"name":"家庭AI","type":"select","proxies":["家庭代理"],"include-all":true,"interval":600,"lazy":true},{"name":"家庭流媒体","type":"select","proxies":["家庭代理"],"include-all":true,"interval":600,"lazy":true},{"name":"家庭社交","type":"select","proxies":["家庭代理"],"include-all":true,"interval":600,"lazy":true}]
rule-providers:
  {"family-apple-cn":{"behavior":"domain","format":"mrs","url":"https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/apple-cn.mrs","interval":86400}}
rules: #!replace
  ["DOMAIN-SUFFIX,lan,DIRECT","DOMAIN-SUFFIX,local,DIRECT","DOMAIN,localhost,DIRECT","IP-CIDR,127.0.0.0/8,DIRECT,no-resolve","IP-CIDR,10.0.0.0/8,DIRECT,no-resolve","IP-CIDR,172.16.0.0/12,DIRECT,no-resolve","IP-CIDR,192.168.0.0/16,DIRECT,no-resolve","IP-CIDR,169.254.0.0/16,DIRECT,no-resolve","IP-CIDR,100.64.0.0/10,DIRECT,no-resolve","IP-CIDR6,::1/128,DIRECT,no-resolve","IP-CIDR6,fc00::/7,DIRECT,no-resolve","IP-CIDR6,fe80::/10,DIRECT,no-resolve","DOMAIN,dns.alidns.com,DIRECT","DOMAIN,doh.pub,DIRECT","IP-CIDR,223.5.5.5/32,DIRECT,no-resolve","IP-CIDR,119.29.29.29/32,DIRECT,no-resolve","IP-CIDR,1.1.1.1/32,家庭代理,no-resolve","IP-CIDR,1.0.0.1/32,家庭代理,no-resolve","IP-CIDR,8.8.8.8/32,家庭代理,no-resolve","IP-CIDR,8.8.4.4/32,家庭代理,no-resolve","DOMAIN-SUFFIX,openai.com,家庭代理","DOMAIN-SUFFIX,chatgpt.com,家庭代理","DOMAIN-SUFFIX,oaistatic.com,家庭代理","DOMAIN-SUFFIX,oaiusercontent.com,家庭代理","DOMAIN-SUFFIX,anthropic.com,家庭代理","DOMAIN-SUFFIX,claude.ai,家庭代理","DOMAIN-SUFFIX,claude.com,家庭代理","DOMAIN-SUFFIX,x.ai,家庭代理","DOMAIN-SUFFIX,grok.com,家庭代理","DOMAIN-SUFFIX,gemini.google.com,家庭代理","DOMAIN-SUFFIX,generativelanguage.googleapis.com,家庭代理","DOMAIN-SUFFIX,ai.google.dev,家庭代理","DOMAIN-SUFFIX,google.com,家庭代理","DOMAIN-SUFFIX,googleapis.com,家庭代理","DOMAIN-SUFFIX,gstatic.com,家庭代理","DOMAIN-SUFFIX,googleusercontent.com,家庭代理","DOMAIN-SUFFIX,github.com,家庭代理","DOMAIN-SUFFIX,githubusercontent.com,家庭代理","DOMAIN-SUFFIX,githubassets.com,家庭代理","DOMAIN-SUFFIX,youtube.com,家庭代理","DOMAIN-SUFFIX,youtu.be,家庭代理","DOMAIN-SUFFIX,googlevideo.com,家庭代理","DOMAIN-SUFFIX,ytimg.com,家庭代理","DOMAIN-SUFFIX,netflix.com,家庭代理","DOMAIN-SUFFIX,nflxvideo.net,家庭代理","DOMAIN-SUFFIX,nflximg.net,家庭代理","DOMAIN-SUFFIX,nflxso.net,家庭代理","DOMAIN-SUFFIX,disneyplus.com,家庭代理","DOMAIN-SUFFIX,telegram.org,家庭代理","DOMAIN-SUFFIX,t.me,家庭代理","DOMAIN-SUFFIX,telegra.ph,家庭代理","DOMAIN-SUFFIX,telegram.me,家庭代理","DOMAIN-SUFFIX,whatsapp.com,家庭代理","DOMAIN-SUFFIX,whatsapp.net,家庭代理","DOMAIN-SUFFIX,signal.org,家庭代理","DOMAIN-SUFFIX,discord.com,家庭代理","DOMAIN-SUFFIX,discord.gg,
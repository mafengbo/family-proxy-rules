name: "家庭分流 兼容版 2026-10-21"
desc: "保留原DNS与兜底，仅前置服务分流及微信例外；请停用旧严格版后再启用。"
dns:
  {"nameserver-policy":{"+.weixin.qq.com":["https://223.5.5.5/dns-query"],"+.servicewechat.com":["https://223.5.5.5/dns-query"],"+.wechat.com":["https://223.5.5.5/dns-query"],"+.weixin.com":["https://223.5.5.5/dns-query"],"+.wechatpay.com":["https://223.5.5.5/dns-query"],"+.wechatpay.cn":["https://223.5.5.5/dns-query"],"+.weixinbridge.com":["https://223.5.5.5/dns-query"],"+.wechatos.net":["https://223.5.5.5/dns-query"],"+.qpic.cn":["https://223.5.5.5/dns-query"],"+.qlogo.cn":["https://223.5.5.5/dns-query"],"+.wx.gtimg.com":["https://223.5.5.5/dns-query"],"+.res.wx.qq.com":["https://223.5.5.5/dns-query"],"+.wxcloudrun.com":["https://223.5.5.5/dns-query"],"+.wxgateway.com":["https://223.5.5.5/dns-query"]}}
proxy-groups:
  [{"name":"家庭代理","type":"select","include-all":true,"interval":600,"lazy":true},{"name":"家庭AI","type":"select","proxies":["家庭代理"],"include-all":true,"interval":600,"lazy":true},{"name":"家庭流媒体","type":"select","proxies":["家庭代理"],"include-all":true,"interval":600,"lazy":true},{"name":"家庭社交","type":"select","proxies":["家庭代理"],"include-all":true,"interval":600,"lazy":true}]
rule-providers:
  {"family-apple-cn":{"behavior":"domain","format":"mrs","url":"https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/apple-cn.mrs","interval":86400}}
